# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=the_surface

# NASA FIRMS
NASA_FIRMS_MAP_KEY=your_firms_api_key_here

# Weather
WEATHER_API_BASE_URL=your_weather_api_base_url
FORECAST_API_URL=https://api.open-meteo.com/v1/forecast

# AI chatbot
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.5

# Authentication
JWT_SECRET=replace_with_a_random_secret
JUDGE_EMAIL=judge@thesurface.demo
JUDGE_PASSWORD=replace_with_a_demo_password

# Prediction engine
FIRMS_SOURCES=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
BBOX_DEG=0.5
CACHE_TTL_SECONDS=21600

# Frontend
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173